# Environment Configuration for HabitFlow

# General
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://habitflow_user:habitflow_secret_password@localhost:5432/habitflow_production?schema=public"

# Redis (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & Security
JWT_SECRET=habitflow_super_secret_jwt_key_replace_in_prod
JWT_EXPIRATION=7d

# OpenAI API (For AI Productivity Coach)
OPENAI_API_KEY=your_openai_api_key_here

# Notification Channels (Optional Integrations)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
